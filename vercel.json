    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/usage-agreement.html",
      "destination": "/usage-agreement",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/high-conflict-co-parenting-messages.html",
      "destination": "/high-conflict-co-parenting-messages",
      "permanent": true
    },
    {
      "source": "/co-parenting-text-message-templates.html",
      "destination": "/co-parenting-text-message-templates",
      "permanent": true
    },
    {
      "source": "/features.html",
      "destination": "/features",
      "permanent": true
    },
    {
      "source": "/features/message-shield.html",
      "destination": "/features/message-shield",
      "permanent": true
    },
    {
      "source": "/features/tone-guardian.html",
      "destination": "/features/tone-guardian",
      "permanent": true
    },
    {
      "source": "/features/decree.html",
      "destination": "/features/decree",
      "permanent": true
    },
    {
      "source": "/co-parenting-expense-messages.html",
      "destination": "/co-parenting-expense-messages",
      "permanent": true
    },
    {
      "source": "/biff-co-parenting-messages.html",
      "destination": "/biff-co-parenting-messages",
      "permanent": true
    },
    {
      "source": "/parallel-parenting-communication.html",
      "destination": "/parallel-parenting-communication",
      "permanent": true
    },
    {
      "source": "/before-you-send-co-parenting-text.html",
      "destination": "/before-you-send-co-parenting-text",
      "permanent": true
    },
    {
      "source": "/co-parenting-app-vs-message-coach.html",
      "destination": "/co-parenting-app-vs-message-coach",
      "permanent": true
    },
    {
      "source": "/guides.html",
      "destination": "/guides",
      "permanent": true
    },
    {
      "source": "/co-parenting-school-pickup-messages.html",
      "destination": "/co-parenting-school-pickup-messages",
      "permanent": true
    },
    {
      "source": "/co-parenting-holiday-schedule-messages.html",
      "destination": "/co-parenting-holiday-schedule-messages",
      "permanent": true
    },
    {
      "source": "/co-parenting-medical-update-messages.html",
      "destination": "/co-parenting-medical-update-messages",
      "permanent": true
    },
    {
      "source": "/co-parenting-boundaries-text-examples.html",
      "destination": "/co-parenting-boundaries-text-examples",
      "permanent": true
    },
    {
      "source": "/texas-co-parenting-messages.html",
      "destination": "/texas-co-parenting-messages",
      "permanent": true
    },
    {
      "source": "/co-parenting-summer-schedule-messages.html",
      "destination": "/co-parenting-summer-schedule-messages",
      "permanent": true
    },
    {
      "source": "/co-parenting-stepparent-messages.html",
      "destination": "/co-parenting-stepparent-messages",
      "permanent": true
    },
    {
      "source": "/co-parenting-right-of-first-refusal-messages.html",
      "destination": "/co-parenting-right-of-first-refusal-messages",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
